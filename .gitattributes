# 统一换行：仓库内 LF，Windows 检出也保持 LF（避免 CI 与本地 diff 噪音）
* text=auto eol=lf

# 二进制
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.npz binary
*.pt binary

# 可选备份中的大型文件走 Git LFS（需在提交前执行 git lfs install）
backups/e2/**/*.npz filter=lfs diff=lfs merge=lfs -text
backups/e2/**/*.pt filter=lfs diff=lfs merge=lfs -text
backups/data/** filter=lfs diff=lfs merge=lfs -text
